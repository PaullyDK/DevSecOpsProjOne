              "threats": [
                {
                  "id": "46931f9b-22db-5ab3-8d09-6d449945d3f2",
                  "title": "Brute force / credential stuffing on /login",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "No rate limiting or lockout on /login; 6-char minimum password.",
                  "mitigation": "Add express-rate-limit on /login, /register and /guest; raise password policy.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "3e5eb471-e9b0-599c-b503-798704cc3f04",
                  "title": "User enumeration via login error messages",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Information disclosure",
                  "description": "Unknown email returns 'Database error' while DB errors return 'Invalid email or password' (messages swapped), so responses differ.",
                  "mitigation": "Return one generic 'Invalid email or password' for every failure.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                }
              ]
