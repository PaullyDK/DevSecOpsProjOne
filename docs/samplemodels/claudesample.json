            "id": "8d7f07b9-1535-5790-b02a-6e3a90d15252",
            "zIndex": 14,
            "data": {
              "type": "tm.Process",
              "name": "Express server (server.js)",
              "description": "Node/Express 5 app: auth (bcrypt + express-session), budgets/transactions API, static file serving.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "66c60532-ce8c-5ec5-a5b3-81ac517c232d",
                  "title": "IDOR: access/modify other users' budgets and transactions",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "DELETE /budgets/:id, GET /transactions/:budgetId, DELETE /transactions/:id and POST /transactions never verify the budget belongs to req.session.userId. Any logged-in user (including guests) can read or delete anyone's data by changing the ID.",
                  "mitigation": "Scope every query by owner: e.g. DELETE FROM budgets WHERE id = ? AND user_id = ?; JOIN budgets on user_id for transaction routes.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "b03ea04c-794d-5d67-ada5-859b22c467b2",
                  "title": "Guest account escalates to other users' data",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "The unauthenticated /guest route issues a full session; combined with the IDOR this gives any visitor access to real users' data.",
                  "mitigation": "Fixed by the IDOR ownership checks; optionally rate-limit /guest.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "47aaa422-fb51-5377-adac-5bf3dc9a44b6",
                  "title": "Source code and schema downloadable",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information disclosure",
                  "description": "express.static(__dirname) serves the project root: /server.js, /schema.sql, /package.json are public. (.env/.git are only protected by the default dotfiles:'ignore'.)",
                  "mitigation": "Move front-end files to public/ and serve express.static('public').",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                },
                {
                  "id": "88b5680e-9873-55f1-9356-1699d2304cd4",
                  "title": "Missing security headers",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information disclosure",
                  "description": "No CSP, X-Frame-Options, X-Content-Type-Options, HSTS (expected ZAP findings).",
                  "mitigation": "Add helmet() middleware with a CSP.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": ""
                },
                {
                  "id": "13a31733-017f-58a3-ab2d-53eea5ba1f09",
                  "title": "No audit trail for destructive actions",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Repudiation",
                  "description": "Deletes and profile/password changes are not logged with user and timestamp; only console.log.",
                  "mitigation": "Add structured logging (e.g. pino) of security-relevant events.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": ""
                },
                {
                  "id": "9f155eb3-70bc-5bd6-a73e-ee00febe5447",
                  "title": "Resource exhaustion via /guest and bcrypt",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "/guest is unauthenticated and does bcrypt + 7 inserts per call; can be spammed. Pruning to 25 accounts limits DB growth only.",
                  "mitigation": "Rate-limit /guest and /login; return early under load.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                }
              ]
            }
