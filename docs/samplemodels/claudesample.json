            "zIndex": 11,
            "data": {
              "type": "tm.Actor",
              "name": "User / Guest (browser)",
              "description": "Registered user or anonymous guest using the SPA pages (index, transactions, profile).",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "8e1cec68-3b79-5302-83dc-11dd61e59879",
                  "title": "Stored XSS via transaction title / budget category",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "index.html:306 and transactions.html:105 render txn.title with innerHTML. A malicious title runs script in the victim's browser.",
                  "mitigation": "Render user data with textContent / createElement instead of innerHTML; add a Content-Security-Policy (helmet).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "262f3132-b36d-5731-9b97-528dac139de1",
                  "title": "Cross-site request forgery on state-changing routes",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "POST/PUT/DELETE routes rely only on the session cookie; no CSRF token and no SameSite attribute set.",
                  "mitigation": "Set cookie sameSite='strict' (or 'lax') and/or add CSRF tokens.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "9eb53acc-f9c1-568a-a784-5d06bbdfe45d",
                  "title": "Session cookie theft",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Stolen user_session cookie would allow impersonation.",
                  "mitigation": "Cookie is httpOnly and secure in production; 1-day maxAge. Add sameSite.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ]
            }
          },
